{
  "name": "ovemodus",
  "version": "0.1.0",
  "private": true,
  "description": "Øvemodus for keyboard: lytter via mikrofon eller MIDI, viser noter og neste tangent.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prototype": "APP_URL=file://$PWD/prototype/ovemodus.html playwright test"
  },
  "dependencies": {
    "abcjs": "6.4.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
